DATABASE_URL=
# Lectura publica como web_reader (ADR-014 §4): Production y Preview en Vercel
DATABASE_URL_PUBLIC=
# Solo para npm run db:web-reader; ASCII imprimible, 16+ (openssl rand -hex 32)
WEB_READER_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INGEST_TICK_TOKEN=
# URL absoluta de /api/ingest/tick en produccion (secreto ingest_tick_url del Vault)
INGEST_TICK_URL=
# Mismo valor que INGEST_TICK_TOKEN: Vercel Cron manda Bearer $CRON_SECRET (H-2)
CRON_SECRET=
# Fuente rfef vía explorer (ADR-023, SPEC-038): origen del servicio explorer
# (sin ruta; el adaptador pide /api/export/matches?date=) y su Bearer.
RFEF_EXPLORER_URL=
RFEF_EXPLORER_TOKEN=
# Marca del gol reciente (SPEC-042): box | label; vacia o invalida -> label.
# Puesta en Vercel en Production y Preview.
RECENT_GOAL_MARK=
# Tira de días de la jornada: true | false; vacía o no definida -> false (oculta por defecto).
SHOW_DAY_STRIP=
