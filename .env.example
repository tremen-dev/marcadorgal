DATABASE_URL=
# Lectura publica como web_reader (ADR-014 §4): Production y Preview en Vercel
DATABASE_URL_PUBLIC=
# Solo para npm run db:web-reader; ASCII imprimible, 16+ (openssl rand -hex 32)
WEB_READER_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INGEST_TICK_TOKEN=
# URL absoluta de /api/ingest/tick en produccion (secreto ingest_tick_url del Vault)
INGEST_TICK_URL=
# Mismo valor que INGEST_TICK_TOKEN: Vercel Cron manda Bearer $CRON_SECRET (H-2)
CRON_SECRET=
# Fuente rfef vía explorer (ADR-023, SPEC-038): origen del servicio explorer
# (sin ruta; el adaptador pide /api/export/matches?date=) y su Bearer.
RFEF_EXPLORER_URL=
RFEF_EXPLORER_TOKEN=
# Marca del gol reciente (SPEC-042): box | label; vacia o invalida -> label.
# Puesta en Vercel en Production y Preview.
RECENT_GOAL_MARK=
# Tira de días de la jornada: true | false; vacía o no definida -> false (oculta por defecto).
SHOW_DAY_STRIP=
# Enlace «Táboa» de cada competición da xornada: true | false; vacía o no definida -> false (oculto: táboas de Explorer incompletas).
SHOW_TABLE_LINK=
# Redes (SPEC-066, ADR-030 §7). SOCIAL_PUBLISHER: id del publicador del registro
# (src/social/publisher.ts: `buffer`, SPEC-067); vacía, ausente o desconocida
# -> apagado (modo seco: se redacta y queda `skipped`).
SOCIAL_PUBLISHER=
# Secretos de Buffer (SPEC-067 CA-4, ADR-030 §8): solo en Production de Vercel,
# nunca en Preview ni en local salvo para la sonda (`npm run social:probar`,
# canal de pruebas). `buffer` sin alguno de los dos -> apagado y `socialError`
# `unconfigured` en el resumen del tick.
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=
# Ids de equipo (TeamId) separados por comas; vacía -> data/galegos/<temporada>.json
SOCIAL_WATCHED_TEAMS=
# Última línea de cada texto: https://marcador.gal o una ruta suya; vacía -> sin ligazón
SOCIAL_LINK_URL=
